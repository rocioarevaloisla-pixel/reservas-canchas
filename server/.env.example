# Base de datos (usar DATABASE_URL o las variables individuales)
DATABASE_URL=mysql://usuario:password@localhost:3306/reservas_canchas
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reservas_canchas
DB_USER=root
DB_PASSWORD=

# Servidor
PORT=3000

# Seguridad JWT (cambiar por un string secreto largo)
JWT_SECRET=your_jwt_secret_here

# URL del frontend para CORS (producción)
CORS_ORIGIN=http://localhost:5173
